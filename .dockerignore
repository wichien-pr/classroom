# Allowlist the application/build inputs, then remove all local/private artifacts.
**
!Dockerfile
!appworks/
!appworks/*.py
!appworks/requirements.txt
!appworks/templates/**
!appworks/platform-assets/**
!scripts/
!scripts/courses.py
!courses/
!courses/**
**/.git
**/.git/**
**/.env
**/.env.*
**/node_modules
**/dist
**/.venv
**/venv
**/__pycache__
**/.pytest_cache
**/.browsers
**/.playwright
**/test-results
**/playwright-report
**/evidence
**/backups
**/instance
**/profile-photos
**/community-uploads
**/*.sqlite*
**/*.db*
**/*.[pP][dD][fF]
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/.DS_Store
