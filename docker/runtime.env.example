# Copy to docker/runtime.env (gitignored), chmod 600, then configure privately.
# No mail is sent by this safe default. Signup remains OTP-protected/fail-closed.
APPWORKS_COOKIE_SECURE=0
APPWORKS_RESET_ENABLED=0
APPWORKS_RESET_TRANSPORT=smtp
APPWORKS_RESET_BASE_URL=http://localhost:8082
APPWORKS_RESET_ALLOW_LOCAL=1
# For remote HTTPS: COOKIE_SECURE=1, ALLOW_LOCAL=0, BASE_URL=https://your-host
# Enable a provisioned SMTP or Graph transport before accepting registrations.
# See docs/password-reset-contract.md for the complete mail configuration.
# APPWORKS_RESET_ENABLED=1
# APPWORKS_RESET_TRANSPORT=graph
# OUTLOOK_TENANT_ID=replace-with-tenant-guid
# OUTLOOK_CLIENT_ID=replace-with-client-guid
# OUTLOOK_CLIENT_SECRET=replace-privately
# OUTLOOK_USER_EMAIL=replace-with-sender
